# Server
APP_ENV=development
PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=emplyra
DB_PASSWORD=emplyra_password
DB_NAME=emplyra
DB_SSLMODE=disable

# Auth (REQUIRED — replace with a long random string)
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL=168h
REFRESH_TOKEN_LEN=64

# Super admin bootstrap (seeded on startup when SEED_SUPER_ADMIN=true)
SEED_SUPER_ADMIN=true
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@emplyra.local
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_ROLE=SUPER_ADMIN

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Rate limiting
RATE_LIMIT_PER_IP=60
RATE_LIMIT_WINDOW_SECONDS=60

# CORS
CORS_ORIGINS=*

# Tests (optional, integration tests only)
TEST_DB_URL=